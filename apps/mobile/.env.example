# Copy to .env (gitignored). Only the PUBLIC anon key ever ships in the app.
# The service role key lives in Supabase and Vercel environment variables only.
EXPO_PUBLIC_SUPABASE_URL=https://qywowvkkkxldgxoatdsh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat publishable keys (Project → API keys → App-specific). These identify the
# app to RevenueCat and can grant nothing; the secret that can is REVENUECAT_WEBHOOK_SECRET
# in Supabase. With neither set, buying is a no-op that says so.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
