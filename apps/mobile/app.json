{
  "expo": {
    "name": "Zebrasplit",
    "slug": "bunktab",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "zebrasplit",
      "bunktab",
      "checkm8"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bunktab.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSContactsUsageDescription": "Zebrasplit reads your contacts on this device so you can pick who to invite. Only the numbers you choose are sent.",
        "NSCameraUsageDescription": "Zebrasplit uses the camera to photograph receipts.",
        "NSPhotoLibraryUsageDescription": "Zebrasplit uses your photos for receipts and trip covers.",
        "LSApplicationQueriesSchemes": [
          "venmo"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "8LR5F2TH8L",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:zebrasplit.com"
      ]
    },
    "android": {
      "package": "com.bunktab.app",
      "adaptiveIcon": {
        "backgroundColor": "#E2FF2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "zebrasplit.com",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "www.zebrasplit.com",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "venmo"
            }
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E2FF2B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Zebrasplit reads your contacts on this device so you can pick who to invite. Only the numbers you choose are sent."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zebrasplit uses your photos for receipts and trip covers.",
          "cameraPermission": "Zebrasplit uses the camera to photograph receipts."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-apple-authentication",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#E2FF2B",
    "owner": "brad.russell1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "652dbbb4-c619-44bb-80b2-df07159720cc"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/652dbbb4-c619-44bb-80b2-df07159720cc"
    }
  }
}
