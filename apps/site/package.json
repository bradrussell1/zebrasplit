{
  "name": "@bunktab/site",
  "private": true,
  "version": "0.1.0",
  "description": "Zebrasplit marketing site and invite landing pages (zebrasplit.com).",
  "scripts": {
    "tokens": "node ../../packages/theme/scripts/build-css.mjs styles/tokens.css && node scripts/build-og-fonts.mjs",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens && node scripts/check-hex.mjs",
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "node scripts/check-hex.mjs",
    "typecheck": "npm run tokens && tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:align": "node scripts/check-alignment.mjs"
  },
  "dependencies": {
    "@bunktab/core": "*",
    "@bunktab/theme": "*",
    "@supabase/supabase-js": "^2.58.0",
    "@vercel/analytics": "^1.5.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.9.2"
  }
}
