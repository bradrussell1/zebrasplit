# Public site origin (canonical URLs, sitemap, OG, Smart App Banner argument).
NEXT_PUBLIC_SITE_URL=https://zebrasplit.com

# Supabase project; the anon key is the only key the site ever holds. It is used on the
# server to call get_invite_preview(code). Never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Store listings. Leave unset until the apps are live: the badges render as "Coming soon".
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# App Store Connect numeric id, for the iOS Smart App Banner on /join/<code>.
APP_STORE_ID=6818411520

# The web guest view (apps/web). "Continue in browser" and the /i, /t, /sms redirects go here.
NEXT_PUBLIC_WEB_APP_URL=https://app.zebrasplit.com

# Deep links. apple-app-site-association needs TEAM_ID + BUNDLE_ID; assetlinks.json needs
# ANDROID_PACKAGE + ANDROID_SHA256_FINGERPRINTS (comma-separated). Missing values → that file 404s.
TEAM_ID=8LR5F2TH8L
BUNDLE_ID=com.bunktab.app
ANDROID_PACKAGE=com.bunktab.app
ANDROID_SHA256_FINGERPRINTS=

# Cloudflare Turnstile site key for /captcha, the page the mobile app loads before a
# request that sends a text or checks a password. The widget's allowed hostnames must
# include zebrasplit.com. Unset → the page answers "disabled" and the app sends no token
# (then captcha must also be off in Supabase, Auth → Attack protection, or logins fail).
TURNSTILE_SITE_KEY=
